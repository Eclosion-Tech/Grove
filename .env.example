DATABASE_URL=postgres://grove:grove@127.0.0.1:5442/grove
PORT=4310
# Standalone development host only. Replace with a random value, at least 32 characters.
GROVE_DEV_TOKEN=replace-with-a-random-local-token-at-least-32-characters
GROVE_TENANT=local
GROVE_SITE=demo
GROVE_ENVIRONMENT=development

# Private local media storage (default). Binary images are normalized to WebP.
GROVE_MEDIA_DIRECTORY=.grove/media
# Alternatively use a private S3/R2-compatible bucket and server-only credentials:
# GROVE_S3_BUCKET=grove-media
# GROVE_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
