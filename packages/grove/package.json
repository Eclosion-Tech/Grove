{
  "name": "@eclosion-tech/grove",
  "version": "0.1.0",
  "description": "Code-first content workspace and developer-defined administration platform: schema registry, documents with history, media, membership, admin modules and the signed remote module protocol.",
  "license": "AGPL-3.0-only",
  "author": "Eclosion Tech",
  "repository": {
    "type": "git",
    "url": "https://forge.syntropy.chat/Eclosion-Tech/Grove.git",
    "directory": "packages/grove"
  },
  "keywords": [
    "cms",
    "admin",
    "headless",
    "postgres",
    "oidc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "import": "./dist/editing.js"
    },
    "./remote": {
      "types": "./dist/remote-entry.d.ts",
      "import": "./dist/remote-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "postgres": "3.4.9",
    "sharp": "^0.35.4"
  }
}
